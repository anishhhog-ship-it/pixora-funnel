# ==============================================================================
# Pixora Funnel — Environment Configuration Template
# Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local or secret keys to GitHub.
# ==============================================================================

# Supabase Production Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Places & Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google My Business Account Management API Key
GOOGLE_MY_BUSINESS_ACCOUNT_API_KEY=your_gmb_account_api_key_here
NEXT_PUBLIC_GOOGLE_MY_BUSINESS_ACCOUNT_API_KEY=your_gmb_account_api_key_here

# Google OAuth 2.0 Server Configuration (Project: pixora-funnel-511104)
GOOGLE_CLIENT_ID=your_oauth_web_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_PROJECT_ID=pixora-funnel-511104
TOKEN_ENCRYPTION_KEY=your_32_byte_aes_token_encryption_key_here

# Netlify scheduled Google review sync (set the same random value in Netlify)
NETLIFY_REVIEW_SYNC_SECRET=replace_with_a_long_random_secret
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# Productmate Google review-link integration (optional; defaults to 10 seconds)
PRODUCTMATE_TIMEOUT_MS=10000

# Application Mode
NEXT_PUBLIC_DEMO_MODE=false

# Mobile app release links (optional until public builds are published)
# Leave blank to show a safe "Coming soon" state on /download.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
NEXT_PUBLIC_IOS_STORE_URL=
NEXT_PUBLIC_MOBILE_APP_VERSION=1.0.0
# Optional overrides when a future build changes either identifier.
NEXT_PUBLIC_ANDROID_PACKAGE_ID=com.pixora.funnel
NEXT_PUBLIC_IOS_BUNDLE_ID=com.pixora.funnel
